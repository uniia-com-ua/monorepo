# Strapi CMS connection
STRAPI_URL=https://cms.uniia.com.ua
STRAPI_API_TOKEN=your-read-only-api-token-here

# Cloudflare Access (required when Strapi is behind CF Zero Trust)
CF_ACCESS_CLIENT_ID=1234567890
CF_ACCESS_CLIENT_SECRET=1234567890

# On-demand revalidation secret (must match Strapi webhook header)
REVALIDATION_SECRET=your-webhook-secret-here
