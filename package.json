{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:landing": "turbo run build --filter=landing",
    "build:strapi": "turbo run build --filter=strapi",
    "start": "turbo start",
    "start:landing": "turbo run start --filter=landing",
    "start:strapi": "turbo run start --filter=strapi",
    "dev": "turbo dev",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:strapi": "turbo run dev --filter=strapi",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "ui:add": "pnpm dlx shadcn@latest add -c packages/ui",
    "db:start": "pnpm --filter strapi db:start",
    "db:stop": "pnpm --filter strapi db:stop"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.8.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "core-js-pure",
      "esbuild",
      "sharp"
    ]
  }
}
